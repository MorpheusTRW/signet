# URL di services/engine raggiungibile dal dispositivo/emulatore Android.
# - Emulatore Android Studio: http://10.0.2.2:3000 (alias per il localhost del host)
# - Dispositivo fisico (Seeker) sulla stessa rete: http://<ip-lan-del-tuo-mac>:3000
EXPO_PUBLIC_ENGINE_API_URL=http://localhost:3000

# RPC Solana mainnet-beta per la sessione wallet (MWA) e validateSwapTx.
# Opzionale: senza, si usa l'RPC pubblico di default (rate limit stretti,
# va bene per debug ma non per uso reale) - consigliato un endpoint dedicato
# (Helius, QuickNode, ...) in produzione.
EXPO_PUBLIC_SOLANA_RPC_URL=
