# services/engine

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# paper | live — non negoziabile: default paper, live richiede flag esplicito
TRADING_MODE=paper

# synthetic | helius-ws | yellowstone-grpc
EVENT_SOURCE=synthetic

# richiesto solo per EVENT_SOURCE=helius-ws o yellowstone-grpc
HELIUS_API_KEY=

# Jupiter Swap API
JUPITER_API_BASE_URL=

# Firebase Admin (push FCM)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# SQLite (better-sqlite3)
DATABASE_PATH=./data/seeker-signal.db

# limite esposizione portafoglio (frazione, es. 0.2 = 20%)
MAX_PORTFOLIO_EXPOSURE=0.2
