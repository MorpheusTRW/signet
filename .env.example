# services/engine

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# paper | live — non negoziabile: default paper, live richiede flag esplicito
TRADING_MODE=paper

# synthetic | helius-ws | yellowstone-grpc
EVENT_SOURCE=synthetic

# richiesto solo per EVENT_SOURCE=helius-ws o yellowstone-grpc
# Richiesta con EVENT_SOURCE=helius-ws (piano gratuito sufficiente: logsSubscribe è disponibile su tutti i piani)
HELIUS_API_KEY=
# Tetto giornaliero chiamate Enhanced Transactions (100 crediti l'una, 2 per segnale) per snipe/storico dev
HELIUS_ENHANCED_DAILY_LIMIT=200

# Jupiter Swap API
JUPITER_API_BASE_URL=

# Firebase Admin (push FCM). Senza queste tre, le notifiche restano pianificate
# ma non vengono mai inviate (fail-soft, utile in sviluppo/synthetic mode).
# Presa dal JSON dell'account di servizio (vedi passi Firebase Console in PROGRESS.md):
# FIREBASE_PRIVATE_KEY va incollata con gli "\n" letterali così come appaiono nel
# JSON, tra virgolette — il codice li converte in newline reali a runtime.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# SQLite (better-sqlite3)
DATABASE_PATH=./data/seeker-signal.db

# limite esposizione portafoglio (frazione, es. 0.2 = 20%)
MAX_PORTFOLIO_EXPOSURE=0.2

# Paper trading (F1): portafoglio simulato in SOL, nessun fondo reale
PAPER_PORTFOLIO_SOL=100
PAPER_DEFAULT_POSITION_SOL=2

# Intervallo medio (ms) fra due lanci sintetici generati da EVENT_SOURCE=synthetic
SYNTHETIC_INTERVAL_MS=8000

# RPC Solana per letture on-chain reali (saldo/stake SKR per il tier HOLDER).
# Opzionale: se assente, la verifica HOLDER degrada a "non holder" (fail-closed).
SOLANA_RPC_URL=

# Monetizzazione (CLAUDE.md, sezione Monetizzazione): tutte le soglie e le bps
# stanno qui, mai hardcoded nel codice.
FREE_SIGNAL_DELAY_SECONDS=45
FREE_MAX_SIGNALS_PER_DAY=20
FREE_HISTORY_HOURS=24
PRO_SUBSCRIPTION_DAYS=30
HOLDER_MIN_SKR=10000
FREE_PLATFORM_FEE_BPS=75
PRO_PLATFORM_FEE_BPS=50
HOLDER_PLATFORM_FEE_BPS=30
# Cache (ms) del risultato di verifica HOLDER (saldo+stake SKR)
HOLDER_CACHE_TTL_MS=600000

# Push FCM (F3): intervallo (ms) di polling delle notifiche pianificate e dovute
PUSH_DISPATCH_INTERVAL_MS=5000
# I segnali ad alto rischio restano nel feed; con true generano anche la notifica push
PUSH_HIGH_RISK_SIGNALS=false

# Hardening (F5)
# KILL_SWITCH=true sospende /build-swap all'avvio (poi lo stato è persistito e
# modificabile via POST /admin/kill-switch con "Authorization: Bearer <ADMIN_API_KEY>").
KILL_SWITCH=false
# Min 16 caratteri. Se vuota, gli endpoint /admin/* non esistono.
ADMIN_API_KEY=
# Tetto assoluto (SOL) per singola richiesta /build-swap, oltre al limite del 20%.
MAX_SWAP_SOL=5
# Rate limit /build-swap per wallet (richieste/minuto)
BUILD_SWAP_RATE_LIMIT_PER_MIN=10

# Privacy policy servita su GET /privacy (richiesta per il dApp Store).
# Senza nome ed email la pagina non viene pubblicata.
PRIVACY_CONTROLLER_NAME=
PRIVACY_CONTACT_EMAIL=
PRIVACY_LAST_UPDATED=
