# services/engine

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# paper | live — non negoziabile: default paper, live richiede flag esplicito
TRADING_MODE=paper

# synthetic | helius-ws | yellowstone-grpc
EVENT_SOURCE=synthetic

# richiesto solo per EVENT_SOURCE=helius-ws o yellowstone-grpc
HELIUS_API_KEY=

# Jupiter Swap API
JUPITER_API_BASE_URL=

# Firebase Admin (push FCM)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# SQLite (better-sqlite3)
DATABASE_PATH=./data/seeker-signal.db

# limite esposizione portafoglio (frazione, es. 0.2 = 20%)
MAX_PORTFOLIO_EXPOSURE=0.2

# Paper trading (F1): portafoglio simulato in SOL, nessun fondo reale
PAPER_PORTFOLIO_SOL=100
PAPER_DEFAULT_POSITION_SOL=2

# Intervallo medio (ms) fra due lanci sintetici generati da EVENT_SOURCE=synthetic
SYNTHETIC_INTERVAL_MS=8000

# RPC Solana per letture on-chain reali (saldo/stake SKR per il tier HOLDER).
# Opzionale: se assente, la verifica HOLDER degrada a "non holder" (fail-closed).
SOLANA_RPC_URL=

# Monetizzazione (CLAUDE.md, sezione Monetizzazione): tutte le soglie e le bps
# stanno qui, mai hardcoded nel codice.
FREE_SIGNAL_DELAY_SECONDS=45
FREE_MAX_SIGNALS_PER_DAY=20
FREE_HISTORY_HOURS=24
PRO_SUBSCRIPTION_DAYS=30
HOLDER_MIN_SKR=10000
FREE_PLATFORM_FEE_BPS=75
PRO_PLATFORM_FEE_BPS=50
HOLDER_PLATFORM_FEE_BPS=30
# Cache (ms) del risultato di verifica HOLDER (saldo+stake SKR)
HOLDER_CACHE_TTL_MS=600000
