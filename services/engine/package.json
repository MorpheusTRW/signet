{
  "name": "@seeker-signal/engine",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=../../.env --import tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@seeker-signal/shared": "workspace:*",
    "@solana/spl-token": "^0.4.9",
    "@solana/web3.js": "^1.95.4",
    "better-sqlite3": "^11.5.0",
    "bs58": "^6.0.0",
    "fastify": "^5.1.0",
    "firebase-admin": "^14.4.0",
    "pino": "^9.5.0",
    "tsx": "^4.19.2",
    "ws": "^8.21.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.17.6",
    "@types/ws": "^8.18.1",
    "pino-pretty": "^13.0.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
